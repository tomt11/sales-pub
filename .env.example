# Anthropic — server-side only, never exposed to the client bundle
ANTHROPIC_API_KEY=sk-ant-...

# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...   # used by scripts/seed.ts and never by the app at request time

# Seed user (single-user app; created by `npm run seed` if missing)
SEED_USER_EMAIL=you@example.com
SEED_USER_PASSWORD=change-me-now
